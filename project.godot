config_version=5

[application]
config/name="Downstack"
config/version="0.9.0"
config/icon="res://assets/icon.png"
boot_splash/image="res://assets/icon.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color(0.028,0.027,0.055,1)
run/main_scene="res://main.tscn"
run/max_fps=0
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/subwindows/embed_subwindows=true
window/vsync/vsync_mode=0
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.028,0.027,0.055,1)

[physics]
common/physics_ticks_per_second=120

[input_devices]
pointing/emulate_touch_from_mouse=false
